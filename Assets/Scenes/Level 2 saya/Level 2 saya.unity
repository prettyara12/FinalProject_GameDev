  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: c2731945c9f3d164e8e8d5f494abbf10, type: 3}
    m_FontSize: 15
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 1
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 0
    m_LineSpacing: 1.35
  m_Text: "\U0001F4CD ALUR PENGANTARAN PAKET AREA BANDARA:\n\n1. PAK BENI 2 (Pusat Pengiriman):\n   \u2022 Temui Pak Beni 2 untuk mengambil daftar instruksi 5 paket bandara.\n\n2. NAYA 2 (Paket 1 - Dokumen Penerbangan):\n   \u2022 Penerima paket pertama di area terminal bandara.\n\n3. DIMAS 2 (Paket 2 - Suku Cadang Bagasi):\n   \u2022 Teknisi penanganan bagasi penerima paket kedua.\n\n4. TUKANG PARKIR 2 (Paket 3 - Rompi & Bendera Apron):\n   \u2022 Petugas parkir apron bandara penerima paket ketiga.\n\n5. PAK JOKO 2 (Paket 4 - Logistik Kargo Bandara):\n   \u2022 Penanggung jawab kargo bandara penerima paket keempat.\n\n6. CLARA 2 (Paket 5 - Cinderamata Penerbangan):\n   \u2022 Penumpang/pengunjung penerima paket cinderamata kelima.\n\n7. KEMBALI KE PAK BENI 2:\n   \u2022 Lapor seluruh tugas selesai untuk menyelesaikan misi & mengakhiri permainan!"
